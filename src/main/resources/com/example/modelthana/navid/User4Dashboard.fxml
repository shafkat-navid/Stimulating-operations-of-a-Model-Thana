<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.modelthana.navid.controller.TrafficSergeantController" styleClass="page">
 <top>
  <VBox spacing="5" styleClass="heading">
   <HBox alignment="CENTER_LEFT" spacing="12">
    <VBox spacing="5">
     <Label text="USER 4 - TRAFFIC SERGEANT" styleClass="page-title"/>
     <Label text="Tickets, accidents, deployments, vehicle services, road status and reports"/>
    </VBox>
    <Region HBox.hgrow="ALWAYS"/>
    <Button text="Back to Main Dashboard" onAction="#backToMainDashboard"/>
   </HBox>
  </VBox>
 </top>
 <center>
  <VBox spacing="8">
   <GridPane hgap="12" vgap="8" styleClass="form-area">
    <columnConstraints><ColumnConstraints minWidth="125"/><ColumnConstraints minWidth="220" hgrow="ALWAYS"/>
     <ColumnConstraints minWidth="130"/><ColumnConstraints minWidth="260" hgrow="ALWAYS"/></columnConstraints>
    <Label text="Next record ID" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="idField" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    <Label text="Workflow" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
    <ComboBox fx:id="operationBox" promptText="Choose a traffic workflow" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
    <Label fx:id="formHint" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="4"/>
    <GridPane fx:id="formFields" hgap="12" vgap="8" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="4">
     <columnConstraints><ColumnConstraints minWidth="160"/><ColumnConstraints minWidth="300" hgrow="ALWAYS"/></columnConstraints>
    </GridPane>
    <HBox spacing="8" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="4">
     <Button fx:id="submitButton" text="Submit" onAction="#submit" styleClass="primary-button"/>
     <Button fx:id="viewTicketButton" text="View Ticket" onAction="#viewTicket"/>
     <Button text="Filter History" onAction="#filterRecords"/>
     <Button text="Show Latest" onAction="#showLatest"/>
     <Button text="Clear" onAction="#clearForm"/>
    </HBox>
   </GridPane>
   <BarChart fx:id="reportChart" visible="false" managed="false" prefHeight="180">
    <xAxis><CategoryAxis label="Payment status"/></xAxis>
    <yAxis><NumberAxis label="Tickets"/></yAxis>
   </BarChart>
   <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-line">
    <Label text="History / notifications:"/>
    <Label fx:id="messageLabel" text="Select a workflow to begin." wrapText="true"/>
   </HBox>
   <TableView fx:id="recordTable" VBox.vgrow="ALWAYS">
    <columns>
     <TableColumn fx:id="idColumn" text="ID" prefWidth="70"/>
     <TableColumn fx:id="operationColumn" text="Workflow" prefWidth="135"/>
     <TableColumn fx:id="subjectColumn" text="Subject" prefWidth="125"/>
     <TableColumn fx:id="locationColumn" text="Location" prefWidth="125"/>
     <TableColumn fx:id="dateColumn" text="Date" prefWidth="90"/>
     <TableColumn fx:id="statusColumn" text="Status" prefWidth="175"/>
     <TableColumn fx:id="detailsColumn" text="Saved form data" prefWidth="270"/>
    </columns>
    <placeholder><Label text="No saved history"/></placeholder>
   </TableView>
  </VBox>
 </center>
</BorderPane>
